{
  "name": "display.chat",
  "displayName": "Display Chat",
  "version": "0.1.0",
  "type": "module",
  "description": "Realtime YAML-driven chat mockup renderer and PNG exporter",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/display.chat.git"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*",
    "#component/*": "./src/components/*/index.tsx"
  },
  "scripts": {
    "build": "vite build --mode production",
    "build:development": "vite build --mode development",
    "dev": "vite",
    "lint": "tsc --noEmit --noUnusedLocals --pretty false",
    "test": "bun test --max-concurrency 1 ./test",
    "test:live": "bun run build && target=dist bun test --max-concurrency 1 test/live.test.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "4.8.0-rc.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "colorjs.io": "0.7.1",
    "diff": "9.0.0",
    "es-toolkit": "1.52.0",
    "flatten-string": "0.2.0",
    "json5": "2.2.3",
    "modern-screenshot": "4.7.0",
    "monaco-editor": "0.56.0",
    "mount-root": "0.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.3",
    "shiki": "4.4.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/bun": "1.4.0",
    "@types/fs-extra": "11.0.4",
    "@types/postcss-normalize": "9.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "4.28.8",
    "caniuse-lite": "1.0.30001810",
    "count-in-png": "0.1.0",
    "cssnano-preset-advanced": "9.0.2",
    "eslint": "10.9.1",
    "eslint-config-jaid": "26.0.0",
    "fs-extra": "11.4.0",
    "optis": "0.1.0",
    "postcss-normalize": "13.0.1",
    "puppeteer-core": "25.9.0",
    "sass-embedded": "1.103.1",
    "terser": "5.51.2",
    "tsconfig-jaid-bun": "16.0.0",
    "tsconfig-jaid-react": "16.0.0",
    "type-fest": "5.9.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.2.2",
    "vite-plugin-media-mixins": "0.10.0",
    "vite-plugin-title": "0.6.0"
  }
}
